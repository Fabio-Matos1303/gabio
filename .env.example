# Web (valores públicos e limitados por RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# MVP de tarefas por padrão; false reabilita os módulos em desenvolvimento
VITE_TASKS_MVP=true
# Mostrar a seção Agenda; backend permanece bloqueado até configuração
VITE_GOOGLE_CALENDAR_ENABLED=true
VITE_TELEGRAM_BOT_USERNAME=

# Funções Supabase — configuração no servidor, nunca prefixar com VITE_
PUBLIC_APP_URL=http://127.0.0.1:5173

# Funções e integrações — configurar somente no ambiente servidor
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Integração Google desativada até credenciais e homologação
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_WORKER_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Chave AES-GCM: exatamente 32 bytes aleatórios codificados em base64
GOOGLE_TOKEN_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Agente local — nunca reutilizar a service_role
LOCAL_AGENT_DEVICE_ID=
LOCAL_AGENT_DEVICE_SECRET=
LOCAL_AGENT_API_URL=
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_NAME=
